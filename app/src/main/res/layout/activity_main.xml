<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello World!"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <com.spradhan.uxcomponentLib.CustomButton
        android:id="@+id/btnLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"

        app:cb_cornerRadius="15dp"
        app:cb_gradientColorEnd="#244F85"

        app:cb_gradientColorStart="#7C2285"
        app:cb_gradientOrientation="leftRight"

        app:cb_loadingText="Please wait..."
        app:cb_startIcon="@drawable/login_ic"
        app:cb_strokeColor="#C4BFBF"

        app:cb_strokeWidth="1dp"

        app:cb_text="Login"

        app:cb_textColor="#FFFFFF"

        />


    <com.spradhan.uxcomponentLib.SpinnerField
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

</LinearLayout>